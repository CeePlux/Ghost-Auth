rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: devices
    // Fields: id, name, status, currentNumber, lastActivity, wsUrl
    //
    // Collection: numbers
    // Fields: number, country, source, addedAt, status, otp
    //
    // Collection: logs
    // Fields: timestamp, level, message, deviceId
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "ceejayfx401@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidDevice(data) {
      return data.keys().hasAll(['id', 'name', 'status']) &&
             data.id is string && data.name is string &&
             data.status in ['online', 'offline', 'busy', 'error'];
    }

    function isValidNumber(data) {
      return data.keys().hasAll(['number', 'status']) &&
             data.number is string &&
             data.status in ['new', 'processing', 'success', 'failed', 'banned'];
    }

    function isValidLog(data) {
      return data.keys().hasAll(['timestamp', 'message']) &&
             data.timestamp is string && data.message is string;
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /numbers/{numberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(); // Only admin (service account) should create logs
      allow delete: if isAdmin();
    }
  }
}
